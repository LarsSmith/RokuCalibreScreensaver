{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Deploy to Roku",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoExit",
                "-Command",
                "$config = Get-Content 'roku-dev-config.json' | ConvertFrom-Json; $env:ROKU_DEV_TARGET = $config.roku_dev_target; make install"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "echo": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build Package Only",
            "type": "shell",
            "command": "make",
            "args": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Remove App from Roku",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoExit",
                "-Command",
                "$config = Get-Content 'roku-dev-config.json' | ConvertFrom-Json; $env:ROKU_DEV_TARGET = $config.roku_dev_target; make remove"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "echo": true
            },
            "problemMatcher": []
        }
    ]
}
